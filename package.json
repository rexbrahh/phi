{
  "name": "phi",
  "version": "1.0.2",
  "private": true,
  "description": "A local coding TUI powered by the Claude Agent SDK",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "phi": "dist/src/cli.js"
  },
  "files": [
    "dist/src/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rexbrahh/phi.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/src/cli.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "release:pack": "npm run build && node scripts/package-release.mjs",
    "start": "node dist/src/cli.js",
    "test:pty": "npm run build && python3 test/pty.py",
    "test:load": "npm run build && node --test dist/test/load.js",
    "test:live": "npm run build && node dist/test/live.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@earendil-works/pi-tui": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
